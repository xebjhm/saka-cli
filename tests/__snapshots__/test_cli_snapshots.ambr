# serializer version: 1
# name: test_cli_help_snapshot
  '''
  usage: saka-cli [-h] [-s {nogizaka46,sakurazaka46,hinatazaka46}] [-o OUTPUT]
                  [-i] [--include-offline] [-g GROUP] [-m [MEMBERS ...]]
                  [--cleanup] [--lang {en,ja,zh-TW,zh-CN,yue}] [-v] [--blog]
                  [--ask QUERY] [--kb-index] [--kb-format {text,json,brief}]
                  [--kb-members DIR] [--kb-aliases FILE] [--kb-call-names PATH]
                  [--llm-backend {cloud,local}] [--llm-base-url URL]
                  [--llm-model NAME] [--hw-suggest]
  
  pysaka CLI - Sakamichi Series Media Scraper
  
  options:
    -h, --help            show this help message and exit
    -s {nogizaka46,sakurazaka46,hinatazaka46}, --service {nogizaka46,sakurazaka46,hinatazaka46}
                          Target Service (Group)
    -o OUTPUT, --output OUTPUT
                          Output directory for downloaded content
    -i, --interactive     Run in interactive wizard mode
    --include-offline     Include unsubscribed/past members
    -g GROUP, --group GROUP
                          Filter by Group ID
    -m [MEMBERS ...], --members [MEMBERS ...]
                          Filter by Member IDs
    --cleanup             Remove auth data and config files
    --lang {en,ja,zh-TW,zh-CN,yue}
                          Language (en, ja, zh-TW, zh-CN, yue)
    -v, --verbose         Enable verbose logging
    --blog                Enable Blog Backup mode (all groups supported)
    --ask QUERY           Ask a question against the local knowledge base
    --kb-index            Build the local knowledge base index from synced data
    --kb-format {text,json,brief}
                          Output format for --ask results (text, json, brief)
    --kb-members DIR      Directory containing <service>.json member roster
                          files
    --kb-aliases FILE     Optional curated aliases JSON file for the knowledge
                          base
    --kb-call-names PATH  Optional curated call-names JSON file (directional
                          per-author nicknames) for the knowledge base
    --llm-backend {cloud,local}
                          LLM backend for --ask: cloud (Gemini) or local
                          (Ollama/llama.cpp)
    --llm-base-url URL    Base URL for the local LLM backend (OpenAI-compatible)
    --llm-model NAME      Model name to use with the selected LLM backend
    --hw-suggest          Detect hardware and suggest a local-vs-cloud LLM
                          backend, then exit
  
  '''
# ---
# name: test_cli_version_snapshot
  ''
